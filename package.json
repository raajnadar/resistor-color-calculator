{
	"name": "resistor-color-calculator",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"homepage": "https://raajnadar.github.io/resistor-color-calculator/",
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@mui/material": "7.2.0",
		"react": "19.1.0",
		"react-dom": "19.1.0"
	},
	"scripts": {
		"start": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"predeploy": "npm run lint && npm run tsc && npm run build",
		"deploy": "gh-pages -d dist --repo https://github.com/raajnadar/resistor-color-calculator.git",
		"lint": "eslint .",
		"tsc": "tsc --noEmit",
		"typescript": "npm run tsc"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not ie <= 11",
		"not op_mini all"
	],
	"devDependencies": {
		"@eslint/js": "9.30.0",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"@vitejs/plugin-react": "4.6.0",
		"eslint": "9.30.0",
		"eslint-plugin-react-hooks": "5.2.0",
		"eslint-plugin-react-refresh": "0.4.20",
		"gh-pages": "6.3.0",
		"globals": "16.2.0",
		"typescript": "5.8.3",
		"typescript-eslint": "8.35.1",
		"vite": "7.0.0"
	},
	"prettier": {
		"semi": false,
		"tabWidth": 2,
		"singleQuote": true,
		"useTabs": true,
		"proseWrap": "never",
		"trailingComma": "none"
	}
}
