{
	"name": "resistor-color-calculator",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"homepage": "https://raajnadar.github.io/resistor-color-calculator/",
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@mui/material": "9.4.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"scripts": {
		"start": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"predeploy": "npm run lint && npm run tsc && npm run build",
		"deploy": "gh-pages -d dist --repo https://github.com/raajnadar/resistor-color-calculator.git",
		"lint": "eslint .",
		"tsc": "tsc --noEmit",
		"typescript": "npm run tsc"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not ie <= 11",
		"not op_mini all"
	],
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"eslint": "10.10.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.6",
		"gh-pages": "6.3.0",
		"globals": "17.12.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.69.0",
		"vite": "8.2.2"
	},
	"prettier": {
		"semi": false,
		"tabWidth": 2,
		"singleQuote": true,
		"useTabs": true,
		"proseWrap": "never",
		"trailingComma": "none"
	}
}
